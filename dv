    """
    Feature: drift-agent-infrastructure, Property 4: ECR security configuration
    
    For any ECR repository named "drift-agent", image scanning SHALL be enabled
    
    Validates: Requirements 2.2
    """
    resources = stackgen_client.get_appstack_resources()
    ecr_repos = [r for r in resources if r['resourceType'] == 'aws_ecr']
    
    assert len(ecr_repos) > 0, "No ECR repository found"
    
    for ecr in ecr_repos:
        if ecr['configuration']['name'] == 'drift-agent':
            assert ecr['configuration']['scan_on_push'] == True, \
                "Image scanning must be enabled for security"


