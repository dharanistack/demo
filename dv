# Property 1: Resource Existence
def test_property_1_all_resources_exist(stackgen_client):
    """
    Feature: drift-agent-infrastructure, Property 1: Resource existence
    
    For any deployed appstack, querying StackGen SHALL return exactly 5 core 
    resource types: VPC, ECS, ECR, CloudWatch Log Group, and IAM Role
    
    Validates: Requirements 6.3
    """
    resources = stackgen_client.get_appstack_resources()
    resource_types = [r['resourceType'] for r in resources]
    
    # Must have exactly these 5 resource types
    assert 'aws_vpc' in resource_types, "VPC resource missing"
    assert 'aws_ecs' in resource_types, "ECS resource missing"
    assert 'aws_ecr' in resource_types, "ECR resource missing"
    assert 'aws_cloudwatch_log_group' in resource_types, "CloudWatch log group missing"
    assert 'aws_iam_role' in resource_types, "IAM role missing"
    
    # Should have at least these 5 core types
    assert len(resource_types) >= 5, f"Expected at least 5 resources, got {len(resource_types)}"


# Property 2: ECS Resource Allocation
def test_property_2_ecs_resource_allocation(stackgen_client):
    """
    Feature: drift-agent-infrastructure, Property 2: ECS resource allocation
    
    For any ECS service configuration, the task definition SHALL allocate 
    exactly 512 CPU units and 1024 MB memory
    
    Validates: Requirements 1.1, 1.2
    """
    resources = stackgen_client.get_appstack_resources()
    ecs_services = [r for r in resources if r['resourceType'] == 'aws_ecs']
    
    assert len(ecs_services) > 0, "No ECS service found"
    
    for ecs in ecs_services:
        config = ecs['configuration']
        assert config['ecs_task_container_cpu'] == 512, \
            f"Expected CPU 512, got {config['ecs_task_container_cpu']}"
        assert config['ecs_task_container_memory'] == 1024, \
            f"Expected memory 1024, got {config['ecs_task_container_memory']}"


# Property 3: ECS Service Configuration
def test_property_3_ecs_service_configuration(stackgen_client):
    """
    Feature: drift-agent-infrastructure, Property 3: ECS service configuration
    
    For any ECS service, the desired count SHALL be 1 and ALB creation 
    SHALL be disabled
    
    Validates: Requirements 1.3, 1.5
    """
    resources = stackgen_client.get_appstack_resources()
    ecs_services = [r for r in resources if r['resourceType'] == 'aws_ecs']
    
    assert len(ecs_services) > 0, "No ECS service found"
    
    for ecs in ecs_services:
        config = ecs['configuration']
        assert config['ecs_service_desired_count'] == 1, \
            f"Expected desired count 1, got {config['ecs_service_desired_count']}"
        assert config['create_ingress_alb'] == False, \
            "ALB should not be created for background service"


