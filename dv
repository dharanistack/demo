# Property 7: IAM Role Trust Policy
def test_property_7_iam_role_trust_policy(stackgen_client):
    """
    Feature: drift-agent-infrastructure, Property 7: IAM role trust policy
    
    For any IAM role attached to ECS tasks, the assume role policy SHALL 
    allow ecs-tasks.amazonaws.com
    
    Validates: Requirements 4.2
    """
    resources = stackgen_client.get_appstack_resources()
    iam_roles = [r for r in resources if r['resourceType'] == 'aws_iam_role']
    
    assert len(iam_roles) > 0, "No IAM role found"
    
    for role in iam_roles:
        policy_str = role['configuration']['assume_role_policy']
        assert 'ecs-tasks.amazonaws.com' in policy_str, \
            "IAM role must allow ECS tasks to assume it"


# Property 8: VPC Network Configuration
def test_property_8_vpc_network_configuration(stackgen_client):
    """
    Feature: drift-agent-infrastructure, Property 8: VPC network configuration
    
    For any VPC, DNS hostnames SHALL be enabled and CIDR prefix SHALL be >= 20 
    (meaning /20 or smaller network)
    
    Validates: Requirements 5.1, 5.2, 5.3
    """
    resources = stackgen_client.get_appstack_resources()
    vpcs = [r for r in resources if r['resourceType'] == 'aws_vpc']
    
    assert len(vpcs) > 0, "No VPC found"
    
    for vpc in vpcs:
        config = vpc['configuration']
        
        # Check DNS is enabled
        assert config['enable_dns_hostnames'] == True, \
            "DNS hostnames must be enabled"
        assert config['enable_dns_support'] == True, \
            "DNS support must be enabled"
        
        # Check CIDR is /20 or smaller (prefix >= 20)
        cidr = config['cidr_block']
        prefix = int(cidr.split('/')[1])
        assert prefix >= 20, \
            f"CIDR prefix must be >= 20 (smaller network), got /{prefix}"


# Property 9: VPC Tagging
def test_property_9_vpc_tagging(stackgen_client):
    """
    Feature: drift-agent-infrastructure, Property 9: VPC tagging
    
    For any VPC, tags SHALL include a "Name" key for identification
    
    Validates: Requirements 5.4
    """
    resources = stackgen_client.get_appstack_resources()
    vpcs = [r for r in resources if r['resourceType'] == 'aws_vpc']
    
    assert len(vpcs) > 0, "No VPC found"
    
    for vpc in vpcs:
        tags = vpc['configuration'].get('tags', {})
        assert 'Name' in tags, \
            "VPC must have a 'Name' tag for identification"
        assert tags['Name'], \
            "VPC Name tag must not be empty"


